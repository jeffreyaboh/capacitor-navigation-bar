{
  "name": "@ethion/capacitor-navigation-bar",
  "version": "8.0.1",
  "description": "Capacitor Plugin for Navigation Bar",
  "type": "module",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "private": false,
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "ios/Plugin/module.modulemap",
    "ios/Plugin/Plugin.h",
    "Package.swift",
    "NavigationBar.podspec",
    "EthionCapacitorNavigationBar.podspec"
  ],
  "author": "Jeffrey Aboh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffreyaboh/capacitor-navigation-bar.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/jeffreyaboh/capacitor-navigation-bar/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "navigation",
    "bar",
    "navigation-bar",
    "navigationbar",
    "android",
    "ios",
    "statusbar",
    "mobile",
    "ionic",
    "capacitor-plugin",
    "ui",
    "system-ui",
    "theme",
    "color",
    "immersive",
    "full-screen"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "cd ios && pod install && xcodebuild -workspace Plugin.xcworkspace -scheme Plugin && cd ..",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- autocorrect --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\"",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api NavigationBarPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.js",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch -m 'chore(release): %s' && npm publish",
    "release:minor": "npm version minor -m 'chore(release): %s' && npm publish",
    "release:major": "npm version major -m 'chore(release): %s' && npm publish"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "0.3.0",
    "@capacitor/ios": "^8.0.0",
    "@ionic/eslint-config": "0.4.0",
    "@ionic/prettier-config": "4.0.0",
    "@ionic/swiftlint-config": "2.0.0",
    "eslint": "9.37.0",
    "prettier": "3.6.2",
    "prettier-plugin-java": "2.7.6",
    "rimraf": "6.0.1",
    "rollup": "4.52.4",
    "swiftlint": "2.0.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  }
}
